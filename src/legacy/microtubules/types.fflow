types Microtubule {

    # 2 Position, CountX CountY
    Nucleator << FixedList<<3, Float>>, FixedList<<2, Integer>> >> : Type

    # 3 Position, Unit vector, CountX, CountY
    CellBoundary<< FixedList<<3, Float>>, FixedList<<3, Float>>, FixedList<<2, Integer>> >> : Type

    # 4 Position, Unit Vector
    Retraction << FixedList<<3, Float>>, FixedList<<3, Float >>  >> : Type

    # 4 Position, Unit Vector
    Intermediate << FixedList<<3, Float >>, FixedList<<3, Float>> >> : Type

    # 5 Position, Unit Vector
    Positive << FixedList<<3, Float >>, FixedList<<3, Float>> >> : Type

    # 6 Position, Unit Vector
    Destroyed << FixedList<<3, Float >>, FixedList<<3, Float>> >> : Type

    # 7 position, unit vector
    Junction << FixedList<<3, Float >>, FixedList<<3, Float>> >> : Type

    # 8 Position, Unit Vector
    Zipper << FixedList<<3, Float >>, FixedList<<3, Float>> >> : Type
}