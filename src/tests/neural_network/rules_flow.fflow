# Stage 2: Pressure-driven fluid flow (ODE solve rules)
# Runs on the lattice built by Stage 1
rules NeuralNetwork {

    # Back propagation and learn
    backprop := (input : InputLayer) -- (layer : Layer) -- (output : OutputLayer) << (input_pos : input::Position,
                            image_batch : input::ImageBatch, input_id : input::InputID),
                            (layer_pos : layer::Position,
                            weights : layer::Weights, layer_id : layer::LayerID),
                            (output_pos : output::Position,
                            digit_class : output::DigitClass, output_id : output::OutputID)
    >> -> (input : InputLayer) -- (layer : Layer) -- (output : OutputLayer) << (input_pos : input::Position,
                            image_batch : input::ImageBatch, input_id : input::InputID),
                            (layer_pos : layer::Position,
                            dw : layer::Weights, layer_id : layer::LayerID),
                            (output_pos : output::Position,
                            digit_class : output::DigitClass, output_id : output::OutputID)  >>
solving ( dw := D(weights, t) ) {

            # dummy
            dw : ODE = HELP::activation(100, weights, weights)
        }

}