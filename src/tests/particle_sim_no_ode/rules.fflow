rules particle_rules {

start_to_node := (start : StartType) << spos : start::start_location >> 
        -> (p2 : ParticleNodeCreator) << pos : p2::Position, counter : p2::Counter >> with (heaviside(10, 1)) where {
            counter = 9
            pos = [spos[0] + 1, spos[1] + 1]
    }

create_particle := (p1 : ParticleNodeCreator) << pos : p1::Position, counter : p1::Counter >> 
        -> (p1 : ParticleNodeCreator) (p2 : ParticleNode) -- (p3 : ParticleNode) -- (p4 : ParticleNode)
        << (npos : p1::Position, new_counter : p1::Counter), (p2pos : p2::Position), (p3pos : p3::Position), (p4pos : p4::Position) >> with (heaviside(counter, 1)) where {

        new_counter = counter - 1
        npos = [pos[0] - 0.9, pos[1] - 0.9]

        p2pos = [pos[0] + 0.3, pos[1] + 0.3]

        p3pos = [pos[0] + 0.6, pos[1] + 0.6]

        p4pos = [pos[0] + 0.6, pos[1] + 0.1]


    }

}
