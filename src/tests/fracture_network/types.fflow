types Microtubule {

    # X, Y, pressure, Direction
    FractureSegment << FixedList<<3, Float>>, Float, FixedList<<3, Float>> >> : Type

    # X, Y, pressure, Direction
    FractureSegmentEnd << FixedList<<3, Float>>, Float, FixedList<<3, Float>>  >> : Type

    # X, Y, pressure, Direction
    Junction << FixedList<<3, Float>>, Float, FixedList<<3, Float>>  >> : Type

    PressureSegment<< FixedList<<3, Float>>, Float >> : Type

    # Source of pressure
    PressureSource << FixedList<<3, Float>>, Float, FixedList<<3, Float>> >> : Type

	# X, Y, Z, CounterX, CounterY, CounterZ
	RockStart << FixedList<<3, Float>>, Float, Float, Float >> : Type
	Rock<< FixedList<<3, Float>>, Float >> : Type

}
