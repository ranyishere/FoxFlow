rules Microtubule {

  start_node_up := (start : StartType) << (spos : start::start_location) >> -> 
    (cell0 : WildType) (cell1 : HiddenMutant)
    << (pos0 : cell0::Position), (vel0 : cell0::Velocity), (age0 : cell0::Age), (ident0 : cell0::Identity), (dir0 : cell0::Direction),
      (pos1 : cell1::Position), (vel1 : cell1::Velocity), (age1 : cell1::Age), (ident1 : cell1::Identity), (dir1 : cell1::Direction) >> with (1.0) where {

      pos0 = [2.0, 2.0, 2.0]

      vel0 = [0, 0, 0]

      dir0 = [1.0, 1.0, 1.0]

      age0 = ~UniformDistribution(0, 26)
      ident0 = ~NormalDistribution(1, 0.3)
      
      pos1 = [1.5, 1.5, 1.5]

      vel1 = [0, 0, 0]

      dir1 = [1.0, 1.0, 1.0]

      age1 = ~UniformDistribution(0, 26)
      ident1 = ~NormalDistribution(1, 0.3)

    }

    activate_mutant := (cell : HiddenMutant) << (pos : cell::Position), (vel : cell::Velocity), (age : cell::Age), (ident : cell::Identity), (dir : cell::Direction) >> -> 
    (new_cell : Mutant) << (npos : new_cell::Position), (nvel : new_cell::Velocity), (nage : new_cell::Age), (nident : new_cell::Identity), (ndir : new_cell::Direction) >> with (
        heaviside(age, 26*2) ) where {


        nvel = vel

        npos = pos

        nident = ident

        ndir = dir

    }

    # TODO: Add Polytype morphism
    hidden_mutant_identity_drift := (cell0 : HiddenMutant) << (pos : cell0::Position), (vel : cell0::Velocity), (age : cell0::Age), (ident : cell0::Identity), (dir : cell0::Direction) >> -> 
    (cell1 : HiddenMutant) << (npos : cell1::Position), (nvel : cell1::Velocity), (nage : cell1::Age), (nident : cell1::Identity), (ndir : cell1::Direction) >> with (0.5) where {

        muWildType : Float := 1

        a : Float := 0.9753

        sig_init : Float := 0.5
        # epsilon : Float := 0.1
        epsilon : Float := ~NormalDistribution(0,1)

        npos = pos

        nvel = vel

        nage = age

        nident = muWildType + a*(pos[0]-muWildType) + sig_init*sqrt(1 - a*a)*epsilon

        ndir = dir
    }


    # TODO: Add Polytype morphism
    mutant_identity_drift := (cell0 : Mutant) << (pos : cell0::Position), (vel : cell0::Velocity), (age : cell0::Age), (ident : cell0::Identity), (dir : cell0::Direction) >> -> 
    (cell1 : Mutant) << (npos : cell1::Position), (nvel : cell1::Velocity), (nage : cell1::Age), (nident : cell1::Identity), (ndir : cell1::Direction) >> with (0.5) where {

        muWildType : Float := 1

        a : Float := 0.9753

        nvel = vel

        sig_init : Float := 0.5
        # epsilon : Float := 0.1
        epsilon : Float := ~NormalDistribution(0,1)

        npos = pos

        nage = age

        nident = muWildType + a*(pos[0]-muWildType) + sig_init*sqrt(1 - a*a)*epsilon

        ndir = dir
    }


    # TODO: Add Polytype morphism
    identity_drift := (cell0 : WildType) << (pos : cell0::Position), (age : cell0::Age), (ident : cell0::Identity), (dir : cell0::Direction) >> -> 
    (cell1 : WildType) << (npos : cell1::Position), (nage : cell1::Age), (nident : cell1::Identity), (ndir : cell1::Direction) >> with (0.5) where {

        muWildType : Float := 1

        a : Float := 0.9753

        sig_init : Float := 0.5
        # epsilon : Float := 0.1
        epsilon : Float := ~NormalDistribution(0,1)

        npos = pos

        nage = age

        nident = muWildType + a*(pos[0]-muWildType) + sig_init*sqrt(1 - a*a)*epsilon

        ndir = dir

    }

    age_cells := (cell0 : WildType) << (pos : cell0::Position), (age : cell0::Age), (ident : cell0::Identity), (dir : cell0::Direction) >> ->
    (agedCell : WildType) << (apos : agedCell::Position), (da : agedCell::Age), (aident : agedCell::Identity), (adir : agedCell::Direction) >> solving (da := D(age,t)) {
        # speedUp : Float := 3
        # TODO: Support constants and function calls
        da : ODE = 1.1 * 3
    }

    mutant_age_cells := (cell0 : Mutant) << (pos : cell0::Position), (age : cell0::Age), (ident : cell0::Identity), (dir : cell0::Direction) >> ->
    (agedCell : Mutant) << (apos : agedCell::Position), (da : agedCell::Age), (aident : agedCell::Identity), (adir : agedCell::Direction) >> solving (da := D(age,t)) {
        # speedUp : Float := 3
        # TODO: Support constants and function calls
        da : ODE = 1.1 * 3
    }


    divide_wild_type_x := (cell0 : WildType) << (pos : cell0::Position), (age : cell0::Age), (ident : cell0::Identity), (dir : cell0::Direction) >> ->
    (cell0 : WildType) (cell1 : WildType) <<
        (pos0 : cell0::Position), (age0 : cell0::Age), (ident0 : cell0::Identity), (dir0 : cell0::Direction),
        (pos1 : cell1::Position), (age1 : cell1::Age), (ident1 : cell1::Identity), (dir1 : cell1::Direction) >> with (heaviside(age, 26)) where {
            
        divideNoise0 : Float := ~NormalDistribution(0, 0.01)
        divideNoise1 : Float := ~NormalDistribution(0, 0.01)

        pos0 = [pos[0] - divide_distance * divide_scale + divideNoise0, pos[1], pos[2]]

        dir0 = [-1, 1, 1]

        age0 = 0
        ident0 = ident

        pos1 = [pos[0] + divide_distance * divide_scale + divideNoise1, pos[1], pos[2]]

        dir1 = [1, 1, 1]

        age1 = 0
        ident1 = ident

    }

    mutant_divide_wild_type_x := (cell0 : Mutant) << (pos : cell0::Position), (age : cell0::Age), (ident : cell0::Identity), (dir : cell0::Direction) >> ->
    (cell0 : Mutant) (cell1 : Mutant) <<
        (pos0 : cell0::Position), (age0 : cell0::Age), (ident0 : cell0::Identity), (dir0 : cell0::Direction),
        (pos1 : cell1::Position), (age1 : cell1::Age), (ident1 : cell1::Identity), (dir1 : cell1::Direction) >> with (heaviside(age, 26)) where {
            
        divideNoise0 : Float := ~NormalDistribution(0, 0.01)
        divideNoise1 : Float := ~NormalDistribution(0, 0.01)

        pos0 = [pos[0] - divide_distance * divide_scale + divideNoise0, pos[1], pos[2]]

        dir0 = [-1, 1, 1]

        age0 = 0
        ident0 = ident

        pos1 = [pos[0] + divide_distance * divide_scale + divideNoise1, pos[1], pos[2]]

        dir1 = [1, 1, 1]

        age1 = 0
        ident1 = ident

    }


    divide_wild_type_y := (cell0 : WildType) << (pos : cell0::Position), (age : cell0::Age), (ident : cell0::Identity), (dir : cell0::Direction) >> ->
    (cell0 : WildType) (cell1 : WildType) <<
        (pos0 : cell0::Position), (age0 : cell0::Age), (ident0 : cell0::Identity), (dir0 : cell0::Direction),
        (pos1 : cell1::Position), (age1 : cell1::Age), (ident1 : cell1::Identity), (dir1 : cell1::Direction) >> with (heaviside(age, 26)) where {
            
        divideNoise0 : Float := ~NormalDistribution(0, 0.01)
        divideNoise1 : Float := ~NormalDistribution(0, 0.01)

        pos0 = [pos[0], pos[1] - divide_distance * divide_scale + divideNoise0, pos[2]]

        dir0 = [dir[0], -1, dir[2]]

        age0 = 0
        ident0 = ident

        pos1 = [pos[0], pos[1] + divide_distance * divide_scale + divideNoise1, pos[2]]

        dir1 = [dir[0], 1, dir[2]]

        age1 = 0
        ident1 = ident

    }

    mutant_divide_wild_type_y := (cell0 : Mutant) << (pos : cell0::Position), (age : cell0::Age), (ident : cell0::Identity), (dir : cell0::Direction) >> ->
    (cell0 : Mutant) (cell1 : Mutant) <<
        (pos0 : cell0::Position), (age0 : cell0::Age), (ident0 : cell0::Identity), (dir0 : cell0::Direction),
        (pos1 : cell1::Position), (age1 : cell1::Age), (ident1 : cell1::Identity), (dir1 : cell1::Direction) >> with (heaviside(age, 26)) where {
            
        divideNoise0 : Float := ~NormalDistribution(0, 0.01)
        divideNoise1 : Float := ~NormalDistribution(0, 0.01)

        pos0 = [pos[0], pos[1] - divide_distance * divide_scale + divideNoise0, pos[2]]

        dir0 = [dir[0], -1, dir[2]]

        age0 = 0
        ident0 = ident

        pos1 = [pos[0], pos[1] + divide_distance * divide_scale + divideNoise1, pos[2]]

        dir1 = [dir[0], 1, dir[2]]

        age1 = 0
        ident1 = ident

    }


}
