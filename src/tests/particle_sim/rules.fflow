rules particle_rules {

transform := (start : StartType) << spos : start::start_location >>  
    -> (p1 : ParabolaParticle) << pos : p1::Position, vel : p1::Velocity >> with (heaviside(10, 1)) where {
        pos = [spos[0], spos[1]]
        vel = [0, 0.6]

    }


move_node := (pb : ParabolaParticle) << pos : pb::Position, vel : pb::Velocity >>  
    -> (pbnew : ParabolaParticle) << dpos : pbnew::Position, dvel : pbnew::Velocity >> solving (dpos[0] := D(pos[0],t), dpos[1] := D(pos[1],t), dvel[0] := D(vel[0],t), dvel[1] := D(vel[1],t) ) {

        dpos[0] : ODE = 0 - 0.1 * pos[1] * vel[1]
        dpos[1] : ODE = 0.1 * pos[0] * vel[1]
        dvel[0] : ODE = 0
        dvel[1] : ODE = 0

    }

}
