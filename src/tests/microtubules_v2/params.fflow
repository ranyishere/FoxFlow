parameters Microtubule {

    # Simulate time in seconds
    TOTAL_TIME : Float := 400

    # How often the simulation is updated
    DELTA : Float := 0.1

    # 1 -> is 1 micrometer (um)
    # Widened from 0.1 so the tip<->boundary co-location match forms reliably
    # near the walls (escaping tips were slipping through because the 4-node
    # boundary-catastrophe match failed to form in the narrow capture window).
    MAXIMAL_REACTION_RADIUS : Float := 0.15
    # varepsilon : Float := MAXIMAL_REACTION_RADIUS * 0.01

    # Anything bigger than this is considered "infinity" for the purposes of the simulation.
    varepsilon : Float := MAXIMAL_REACTION_RADIUS

    # Number of steps in the simulation
    NUM_STEPS : Integer := TOTAL_TIME / DELTA

    MIN_DELTA_STEPS : Integer := 5
    DELTA_DELTA_T : Float := DELTA / MIN_DELTA_STEPS

    # Prevents solver from shrinking too much.
    # The minimum allowable integration step.
    DELTA_T_MIN : Float := DELTA_DELTA_T

    CELL_NX : Float := 3
    CELL_NY : Float := 3
    CELL_NZ : Float := 3

    CELL_DX : Float := 1
    CELL_DY : Float := 1
    CELL_DZ : Float := 1

    # Creation Propensity Rate
    rho_create : Float := 0.026
    rho_grow : Float := 100.0

    rho_retract : Float := 10.0

    L_DIV : Float := 0.075
    # L_DIV : Float := 0.003

    L_min : Float := 0.025


    ######### Boundary Building Parameters #########

    boundary_pts : Integer := 300
    # Inset the walls this far inside the reaction-grid edges (x=0 / x=CELL_NX).
    # A tip that slips past a wall is then still INSIDE the grid and keeps
    # getting matched/caught, instead of exiting the grid and becoming
    # unrecoverable. Must stay < buffer (0.3) so nucleators remain inside.
    boundary_margin : Float := 0.2
    # Segment length so the walls span [boundary_margin, CELL_NX - boundary_margin].
    boundary_offset : Float := (CELL_NX - 2.0*boundary_margin) / boundary_pts
    BOUNDARY_BUILD_SPEED : Float := 100.0

    ############


    # Minimum Segment Length
    s_min : Float := 0.005

    # Maximum Segment Length
    s_max : Float := 0.01

    # Gap left between the outermost nucleators and the boundary wall.
    buffer : Float := CELL_NX / 10.0
    # Number of grid intervals per axis (=> nuc_count_n + 1 nucleators per axis).

    nuc_count_n : Integer := 10

    # Spacing so the grid spans exactly [buffer, CELL_NX - buffer] on each axis.
    offset : Float := (CELL_NX - buffer*2) / nuc_count_n

    creation_factor : Float := 1.0
    creation_rate : Float := 0.0026

    mt_min_segment_init : Float := 0.005
    mt_max_segment_init : Float := 0.01

    v_plus : Float := 0.0615

    # collision_distance : Float := 0.025
    collision_distance : Float := 10.0

    # Collision induced catastrophe (CIC)
    boundary_cic : Float := 4000000

    destruction_factor : Float := 0.0026

    gr_to_ret : Float := 0.016
    ret_to_gr : Float := 0.016

    s_col : Float := 0.025

    rho_int_cic : Float := 12000
    rho_grow_cic : Float := 12000
    rho_retract_cic : Float := 12000

    theta_cic : Float := 40.0
    theta_cross : Float := 40.0

    rho_cross : Float := 200.0 * 100.0
    rho_zip_hit : Float := 4000.0
    rho_zip_guard : Float := 12000.0


    WITH_GROWTH_RATE_FACTOR            : Float := 100.0
    DIV_LENGTH                         : Float := 0.075
    WOBBLE_ANGLE                       : Float := 5.0
    ENABLE_WOBBLE                      : Integer := 1

    V_PLUS                             : Float := 0.0615
    WITH_RETRACTION_RATE_FACTOR        : Float := 10.0
    DIV_LENGTH_RETRACT                 : Float := 0.0025

    V_MINUS                            : Float := 0.05

    COLLISION_DISTANCE                 : Float := 0.025

    COLLISION_DISTANCE_BOUNDARY        : Float := 0.02

    STANDARD_BOUNDARY_CATASTROPHE_RATE : Float := 100.0

    # Deterministic boundary clamp backstop: catches any Positive tip that has
    # slipped past the inset wall (into the band between the wall and the grid
    # edge) using the tip's OWN position, independent of a CellBoundary match.
    # Threshold sits half a margin past the wall so the primary catastrophe
    # handles the wall and the clamp only mops up slippers before the grid edge.
    BOUNDARY_CLAMP_MARGIN              : Float := boundary_margin / 2.0
    DOMAIN_MIN                         : Float := BOUNDARY_CLAMP_MARGIN
    DOMAIN_MAX                         : Float := CELL_NX - BOUNDARY_CLAMP_MARGIN
    BOUNDARY_CLAMP_RATE                : Float := STANDARD_BOUNDARY_CATASTROPHE_RATE
    INTERMEDIATE_CIC_RATE              : Float := 5.0

    POSITIVE_CIC_RATE                  : Float := 5.0
    NEGATIVE_CIC_RATE                  : Float := 5.0
    CATASTROPHE_ANGLE                  : Float := 40.0
    CREATION_RATE                      : Float := 0.5
    CREATION_FACTOR                    : Float := 1.0
    MT_MIN_SEGMENT_INIT                : Float := 0.005
    MT_MAX_SEGMENT_INIT                : Float := 0.01
    MT_DESTRUCTION_RATE                : Float := 100.0

}
