rules Microtubule {

    start_to_node := (start : StartType) << (start_pos : FixedList <<3, Float>> ) >> 
            -> (p1 : Nucleator) (b0 : CellBoundary) << (nuc_pos : FixedList <<3, Float>>, nuc_count : FixedList <<2, Integer >>),
        ( b_pos : FixedList <<3, Float >>, b_unit : FixedList <<3, Float >>, b_count : FixedList <<2, Float>> ) >> with (heaviside(10,1)) where {

        nuc_pos[0] = 0 + buffer
        nuc_pos[1] = 0 + buffer
        nuc_pos[2] = 0

        nuc_count = [10, 10]

        b_pos = [0.0, 0.0, 0.0]
        b_unit = [1.0, 1.0, 1.0]

        b_count = [1, 1]

    }

    #### Creates nuclear grid ####
#     create_nucleator_grid_x := (p1 : Nucleator) << ( nuc_pos : FixedList <<3, Float>>, nuc_count : FixedList <<2, Integer>> ) >> ->
#         (p1 : Nucleator) (p2 : Nucleator) << (nuc_pos : FixedList <<3, Float>>, nuc_count_1 : FixedList <<2, Float >> ),
